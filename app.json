{
  "expo": {
    "name": "Tanu",
    "slug": "tanu",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "static",
      "name": "Tanu",
      "shortName": "Tanu",
      "description": "Everything you own, owe, earn, spend and plan — in one calm place.",
      "themeColor": "#2469FE",
      "backgroundColor": "#FFFFFF",
      "display": "standalone",
      "orientation": "portrait",
      "startUrl": "/",
      "lang": "en",
      "scope": "/"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-sharing",
      [
        "expo-notifications",
        {
          "color": "#2469FE",
          "defaultChannel": "reminders"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Tanu uses Face ID to unlock your finances on this device."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/tanu-mark-white.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#2469FE"
        }
      ]
    ],
    "scheme": "tanu",
    "experiments": {
      "baseUrl": "/tanu"
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#2469FE"
    }
  }
}
