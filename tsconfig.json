{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ],
  // The Plaid pass-through is a separate deployment with its own tsconfig.
  "exclude": [
    "server"
  ]
}
